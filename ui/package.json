{
  "name": "hydrastack-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ssr && npm run build:client",
    "build:ssr": "vite build --mode ssr",
    "build:ssr:watch": "vite build --mode ssr --watch",
    "build:client": "vite build --mode client",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": "^24.22.3"
  }
}
